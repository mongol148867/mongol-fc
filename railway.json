<!doctype html><html lang="{{ lang }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mongol Filechange</title><style>:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;font-family:system-ui,sans-serif;background:#10131a;color:#f3f5f9}main{width:min(100%,520px);padding:30px;border:1px solid #303746;border-radius:22px;background:#191e29;text-align:center}.brand img{width:min(100%,280px)}h1{font-size:28px}p{color:#aeb8ca;overflow-wrap:anywhere;line-height:1.6}.file{margin:22px 0;padding:18px;background:#202735;border-radius:12px;overflow-wrap:anywhere}.btn{display:inline-block;padding:13px 20px;background:#7c9cff;color:#111827;border-radius:10px;text-decoration:none;font-weight:750}.lang{position:absolute;top:18px;right:18px;background:#202735;color:white;padding:8px;border:1px solid #465168;border-radius:8px}a{color:#b9caff}</style></head><body><select class="lang" id="language"><option value="ru" {% if lang=='ru' %}selected{% endif %}>Русский</option><option value="en" {% if lang=='en' %}selected{% endif %}>English</option><option value="bg" {% if lang=='bg' %}selected{% endif %}>Български</option></select><main><div class="brand"><img src="{{ url_for('static', filename='filechange.png') }}" alt="Mongol Filechange"></div><h1>Mongol Filechange</h1>{% if missing %}<p data-t="missing">Файлът не е намерен или връзката му е изтекла.</p><a class="btn" href="/?lang={{ lang }}" data-t="home">Към началната страница</a>{% else %}<p data-t="ready">Файлът е готов за изтегляне.</p><div class="file"><strong>{{ file.original_name }}</strong><p data-t="expires">Връзката е валидна до: {{ expires_at }}</p></div><a class="btn" href="{{ url_for('get_file', code=code, lang=lang) }}" data-t="download">Изтегли файла</a>{% endif %}</main><script>const words={ru:{missing:'Файл не найден или срок действия ссылки истёк.',home:'На главную',ready:'Файл готов к скачиванию.',expires:'Ссылка действует до: {{ expires_at }}',download:'Скачать файл'},en:{missing:'File not found or the link has expired.',home:'Home page',ready:'Your file is ready to download.',expires:'Link expires at: {{ expires_at }}',download:'Download file'},bg:{missing:'Файлът не е намерен или връзката е изтекла.',home:'Начална страница',ready:'Файлът е готов за изтегляне.',expires:'Връзката е валидна до: {{ expires_at }}',download:'Изтегли файла'}};document.getElementById('language').addEventListener('change',e=>{const lang=e.target.value;document.documentElement.lang=lang;document.querySelectorAll('[data-t]').forEach(el=>el.textContent=words[lang][el.dataset.t]);history.replaceState(null,'',location.pathname+'?lang='+lang)});</script></body></html>
